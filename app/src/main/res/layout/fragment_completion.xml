<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="32dp"
    android:background="@android:color/transparent">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="48dp"
        app:cardBackgroundColor="#FDFBF7">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:padding="32dp">

            <View
                android:layout_width="48dp"
                android:layout_height="6dp"
                android:background="#E5E5E5"
                android:layout_marginBottom="32dp"/>

            <ImageView
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:src="@drawable/ic_mindful_logo"
                android:padding="8dp"
                android:background="@drawable/bg_circle_icon" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Perjalanan yang\nIndah!"
                android:textSize="32sp"
                android:textColor="#2C3E2D"
                android:fontFamily="serif"
                android:gravity="center" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Kamu berhasil fokus menyelesaikan 1 langkah kecil hari ini. Berikan apresiasi untuk dirimu."
                android:textSize="16sp"
                android:textColor="#737373"
                android:gravity="center" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="192dp"
                android:layout_height="128dp"
                android:layout_marginVertical="24dp"
                app:cardCornerRadius="24dp"
                app:cardBackgroundColor="#F5F2ED">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="LANGKAH 01\nSELESAI"
                    android:gravity="center"
                    android:textColor="#A3B18A"
                    android:textStyle="bold" />
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnShare"
                android:layout_width="match_parent"
                android:layout_height="68dp"
                android:text="Bagikan Pencapaian"
                android:textSize="18sp"
                android:textColor="#FFFFFF"
                app:cornerRadius="24dp"
                app:backgroundTint="#A3B18A" />

            <TextView
                android:id="@+id/tvBackToHome"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:padding="8dp"
                android:text="Kembali ke Beranda"
                android:textColor="#A3A3A3"
                android:textSize="15sp" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>