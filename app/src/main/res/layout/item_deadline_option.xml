<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="80dp"
    android:layout_margin="4dp"
    android:background="@drawable/bg_border_option"
    android:padding="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvOptionLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAllCaps="true"
            android:textSize="10sp"
            android:textColor="#6B7280" />

        <!-- TextView untuk angka (Besok/Lusa) -->
        <TextView
            android:id="@+id/tvOptionValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#A3B18A" />

        <!-- ImageView untuk Ikon Kalender (Disembunyikan secara default) -->
        <ImageView
            android:id="@+id/ivOptionIcon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_calendar"
            android:visibility="gone"
            android:contentDescription="Calendar Icon" />
    </LinearLayout>
</FrameLayout>