<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F9F7F2">

    <!-- Header Section -->
    <TextView
        android:id="@+id/tvLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="64dp"
        android:text="SEDANG FOKUS"
        android:letterSpacing="0.1"
        android:textColor="#2D2D2D"
        android:alpha="0.4"
        android:textSize="12sp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tvTaskName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Tulis pseudocode"
        android:textColor="#2D2D2D"
        android:textSize="18sp"
        app:layout_constraintTop_toBottomOf="@id/tvLabel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Timer Section -->
    <TextView
        android:id="@+id/tvTimer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="80dp"
        android:text="12:34"
        android:textColor="#2D2D2D"
        android:textSize="100sp"
        android:fontFamily="serif"
        app:layout_constraintTop_toBottomOf="@id/tvTaskName"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Soundscape Section dengan FrameLayout untuk Mute -->
    <LinearLayout
        android:id="@+id/llSoundscape"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="60dp"
        android:gravity="center"
        android:orientation="vertical"
        app:layout_constraintTop_toBottomOf="@id/tvTimer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/btnSoundMenu"
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:src="@drawable/ic_mindful_logo"
                android:padding="8dp"
                android:background="@drawable/bg_circle_icon" />

            <ImageView
                android:id="@+id/btnMute"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="top|end"
                android:src="@drawable/ic_volume"
                android:background="@drawable/bg_circle_icon"
                android:padding="4dp" />
        </FrameLayout>

        <TextView
            android:id="@+id/tvSoundName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="HUJAN HUTAN"
            android:textColor="#2D2D2D"
            android:alpha="0.3"
            android:textSize="10sp"
            android:layout_marginTop="12dp" />
    </LinearLayout>

    <!-- Tombol Selesai -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSelesai"
        android:layout_width="311dp"
        android:layout_height="64dp"
        android:layout_marginTop="60dp"
        android:text="Selesai!"
        android:textAllCaps="false"
        app:backgroundTint="#A3B18A"
        app:cornerRadius="99dp"
        app:layout_constraintTop_toBottomOf="@id/llSoundscape"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Footer Section -->
    <TextView
        android:id="@+id/tvQuote"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="48dp"
        android:text="&quot;Setiap langkah kecil membawamu lebih dekat.&quot;"
        android:textColor="#2D2D2D"
        android:alpha="0.3"
        android:textSize="11sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>

